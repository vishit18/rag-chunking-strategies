    "text": "Acme Technologies is a software company operating across the United Kingdom, Germany, France, and the\nUnited States."
  },
  {
    "element_id": "page_1_text_3",
    "type": "text",
    "page": 1,
    "bbox": {
      "x0": 51.0,
      "y0": 156.25,
      "x1": 501.17,
      "y1": 169.99
    },
    "text": "The company provides cloud infrastructure and artificial intelligence solutions to enterprise customers."
